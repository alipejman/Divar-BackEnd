<div class="container">
  <div class="post">
    <nav></nav>
    <div class="post-content">
      <div class="post-title">
        <h1 class="post-title-h1"><%=post.title%></h1>
        <div class="post-title-location"><%=(post.city || post.province)%></div>
      </div>
      <div class="post-action">
        <button class="post-button-action button" id="call-detail">
          اطلاعات تماس
        </button>
        <button class="post-button-chat button">چت</button>
        <img
          class="post-bookmark"
          src="/home/img/bookmark.svg"
          alt="Bookmark"
        />
        <img src="/home/img/share.svg" class="post-share" alt="Share" />
      </div>
      <div class="post-list">
        <a href="#" class="post-landing">
          <div class="post-row">
            <div class="post-landing-mobile">
              <img src="/home/img/mobile.svg" alt="Mobile" />
              <p>مشخصات کامل آگهی</p>
            </div>
            <div class="post-landing-arrow">
              <img src="/home/img/arrow-down.svg" alt="Arrow" />
            </div>
          </div>
        </a>
        <% for (key in post.options) { %>
        <hr />
        <div class="post-list-item post-row">
          <div class="post-list-title"><%=key%></div>
          <div class="post-list-detail"><%=post.options[key]%></div>
        </div>
        <% } %>
      </div>
      <div class="post-description">
        <h2 class="post-description-title">توضیحات</h2>
        <div class="post-description-detail">
          <p><%=post.content%></p>
        </div>
      </div>
    </div>
    <div class="post-image">
      <div class="swiper">
        <div class="swiper-wrapper">
          <% for (let image of post.images) { %>
          <div class="swiper-slide post-thumbnail">
            <img src="/<%=image%>" alt="Image" style="width: 100%" />
          </div>
          <% } %>
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-scrollbar"></div>
      </div>
    </div>
    <div class="post-note">
      <div class="post-note-input">
        <textarea name="note" id="note" placeholder="یادداشت شما..."></textarea>
      </div>
      <p>یادداشت تنها برای شما قابل دیدن است و پس از حذف آگهی، پاک خواهد شد.</p>
    </div>
    <div class="post-privacy-links">
      <a href="#" class="post-privacy-link">
        <div class="post-privacy post-row">
          <img src="/home/img/message.svg" alt="Message" />
          <p>راهنمایی خرید امن</p>
        </div>
      </a>
      <a href="#" class="post-privacy-link">
        <div class="post-privacy post-row">
          <img src="/home/img/message.svg" alt="Message" />
          <p>ثبت تخلف و مشکل آگهی</p>
        </div>
      </a>
    </div>
    <footer></footer>
  </div>
</div>

<style>
  .swiper {
    width: 100%;
    height: 300px;
  }
  .post-title {
    margin-bottom: 15px;
  }
  .post-action {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .post-button-action,
  .post-button-chat {
    margin-right: 10px;
  }
  .post-list-item {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
  }
  .post-description {
    margin-top: 20px;
  }
  .post-note {
    margin-top: 20px;
  }
  .post-privacy-links {
    margin-top: 20px;
  }
  .post-privacy {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  const callDetailBtn = document.querySelector("#call-detail");
  callDetailBtn.addEventListener("click", (e) => {
    Swal.fire({
      title: "<%=post.userMobile%>",
      confirmButtonText: "تماس",
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = "tel://<%=post.userMobile%>";
      }
    });
  });

  const swiper = new Swiper(".swiper", {
    direction: "horizontal",
    loop: true,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    scrollbar: {
      el: ".swiper-scrollbar",
      hide: true,
    },
  });
</script>
<script>
  document.getElementById('menu-toggle').addEventListener('click', function() {
  const sidebar = document.getElementById('sidebar-ul');
  sidebar.classList.toggle('active');
});

</script>